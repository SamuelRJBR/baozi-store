      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"A lista contém o registro criado\", function () { pm.expect(pm.response.json().some(item => item.id === Number(pm.collectionVariables.get(\"clienteId\")))).to.be.true; });"
            ]
